{
  "$id": "urn:autheo:schema:proof:v2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Autheo profile of a W3C Data Integrity proof (eddsa-jcs-2022, single proof)",
  "properties": {
    "@context": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "@Context"
    },
    "created": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "title": "Created",
      "type": "string"
    },
    "cryptosuite": {
      "const": "eddsa-jcs-2022",
      "title": "Cryptosuite",
      "type": "string"
    },
    "proofPurpose": {
      "enum": [
        "assertionMethod",
        "authentication",
        "capabilityDelegation",
        "capabilityInvocation"
      ],
      "title": "Proofpurpose",
      "type": "string"
    },
    "proofValue": {
      "pattern": "^z[1-9A-HJ-NP-Za-km-z]{80,96}$",
      "title": "Proofvalue",
      "type": "string"
    },
    "type": {
      "const": "DataIntegrityProof",
      "title": "Type",
      "type": "string"
    },
    "verificationMethod": {
      "pattern": "^did:(key|web):[A-Za-z0-9._:-]{1,88}#[A-Za-z0-9._~:-]{1,128}$",
      "title": "Verificationmethod",
      "type": "string"
    }
  },
  "required": [
    "type",
    "cryptosuite",
    "created",
    "verificationMethod",
    "proofPurpose",
    "proofValue"
  ],
  "title": "DataIntegrityProof",
  "type": "object"
}

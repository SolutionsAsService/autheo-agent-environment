{
  "$defs": {
    "Capability": {
      "additionalProperties": false,
      "description": "What a delegation grants. A child delegation may only narrow every field of its parent.",
      "properties": {
        "approval_threshold_minor": {
          "maximum": 1000000000000000,
          "minimum": 0,
          "title": "Approval Threshold Minor",
          "type": "integer"
        },
        "asset": {
          "default": "DEMO",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9:._-]{0,63}$",
          "title": "Asset",
          "type": "string"
        },
        "environments": {
          "items": {
            "pattern": "^(\\*|[A-Za-z0-9][A-Za-z0-9:._/-]{0,127}\\*?)$",
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Environments",
          "type": "array"
        },
        "max_delegation_depth": {
          "default": 0,
          "maximum": 8,
          "minimum": 0,
          "title": "Max Delegation Depth",
          "type": "integer"
        },
        "per_action_minor": {
          "maximum": 1000000000000000,
          "minimum": 0,
          "title": "Per Action Minor",
          "type": "integer"
        },
        "resources": {
          "items": {
            "pattern": "^(\\*|[A-Za-z0-9][A-Za-z0-9:._/-]{0,127}\\*?)$",
            "type": "string"
          },
          "maxItems": 50,
          "minItems": 1,
          "title": "Resources",
          "type": "array"
        },
        "schema_version": {
          "const": "autheo.capability/v2",
          "default": "autheo.capability/v2",
          "title": "Schema Version",
          "type": "string"
        },
        "scopes": {
          "items": {
            "enum": [
              "marketplace.read",
              "devhub.read",
              "chain.read",
              "compute.simulate",
              "environment.handoff",
              "tool.invoke",
              "model.invoke",
              "file.read",
              "file.write",
              "network.fetch",
              "message.send",
              "task.checkpoint",
              "dex.quote",
              "dex.policy_check",
              "dex.order.build",
              "dex.order.request_signature",
              "dex.order.sign"
            ],
            "type": "string"
          },
          "maxItems": 12,
          "minItems": 1,
          "title": "Scopes",
          "type": "array"
        },
        "tools": {
          "items": {
            "pattern": "^(\\*|[A-Za-z0-9][A-Za-z0-9:._/-]{0,127}\\*?)$",
            "type": "string"
          },
          "maxItems": 100,
          "title": "Tools",
          "type": "array"
        },
        "total_budget_minor": {
          "maximum": 1000000000000000,
          "minimum": 0,
          "title": "Total Budget Minor",
          "type": "integer"
        }
      },
      "required": [
        "environments",
        "scopes",
        "resources",
        "per_action_minor",
        "total_budget_minor",
        "approval_threshold_minor"
      ],
      "title": "Capability",
      "type": "object"
    },
    "DataIntegrityProof": {
      "additionalProperties": false,
      "description": "Autheo profile of a W3C Data Integrity proof (eddsa-jcs-2022, single proof).",
      "properties": {
        "@context": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "maxItems": 8,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "@Context"
        },
        "created": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
          "title": "Created",
          "type": "string"
        },
        "cryptosuite": {
          "const": "eddsa-jcs-2022",
          "title": "Cryptosuite",
          "type": "string"
        },
        "proofPurpose": {
          "enum": [
            "assertionMethod",
            "authentication",
            "capabilityDelegation",
            "capabilityInvocation"
          ],
          "title": "Proofpurpose",
          "type": "string"
        },
        "proofValue": {
          "pattern": "^z[1-9A-HJ-NP-Za-km-z]{80,96}$",
          "title": "Proofvalue",
          "type": "string"
        },
        "type": {
          "const": "DataIntegrityProof",
          "title": "Type",
          "type": "string"
        },
        "verificationMethod": {
          "pattern": "^did:(key|web):[A-Za-z0-9._:-]{1,88}#[A-Za-z0-9._~:-]{1,128}$",
          "title": "Verificationmethod",
          "type": "string"
        }
      },
      "required": [
        "type",
        "cryptosuite",
        "created",
        "verificationMethod",
        "proofPurpose",
        "proofValue"
      ],
      "title": "DataIntegrityProof",
      "type": "object"
    },
    "DelegationSubject": {
      "additionalProperties": false,
      "properties": {
        "capability": {
          "$ref": "#/$defs/Capability"
        },
        "id": {
          "pattern": "^did:(key|web):[A-Za-z0-9._:-]{1,88}$",
          "title": "Id",
          "type": "string"
        },
        "parent": {
          "anyOf": [
            {
              "$ref": "#/$defs/ParentRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "schema_version": {
          "const": "autheo.delegation/v2",
          "default": "autheo.delegation/v2",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "capability"
      ],
      "title": "DelegationSubject",
      "type": "object"
    },
    "ParentRef": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "id": {
          "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "digest"
      ],
      "title": "ParentRef",
      "type": "object"
    }
  },
  "$id": "urn:autheo:schema:delegation:v2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "W3C VC 2.0 delegation credential from one DID to another (proof: capabilityDelegation)",
  "properties": {
    "@context": {
      "items": {
        "const": "https://www.w3.org/ns/credentials/v2",
        "type": "string"
      },
      "maxItems": 1,
      "minItems": 1,
      "title": "@Context",
      "type": "array"
    },
    "credentialSubject": {
      "$ref": "#/$defs/DelegationSubject"
    },
    "id": {
      "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Id",
      "type": "string"
    },
    "issuer": {
      "pattern": "^did:(key|web):[A-Za-z0-9._:-]{1,88}$",
      "title": "Issuer",
      "type": "string"
    },
    "proof": {
      "$ref": "#/$defs/DataIntegrityProof"
    },
    "type": {
      "items": {
        "enum": [
          "VerifiableCredential",
          "AutheoDelegation"
        ],
        "type": "string"
      },
      "maxItems": 2,
      "minItems": 2,
      "title": "Type",
      "type": "array"
    },
    "validFrom": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "title": "Validfrom",
      "type": "string"
    },
    "validUntil": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "title": "Validuntil",
      "type": "string"
    }
  },
  "required": [
    "@context",
    "type",
    "id",
    "issuer",
    "validFrom",
    "validUntil",
    "credentialSubject",
    "proof"
  ],
  "title": "Delegation",
  "type": "object"
}
